#include<iostream>
#include<string>
#include<vector>
#include<fstream>

using namespace std;


void reverse_order(const string &file, const string &output_file) {
    ifstream infile(file);
    ofstream outfile(output_file);
    
    if (!infile.is_open()) {
        cerr << "Error opening file: " << file << endl;
        return;
    }

    vector<string> words;
    string word;
    while (infile >> word) {
        words.push_back(word);
        
    }

    for (int i = words.size() - 1; i >= 0; --i) {
        outfile << words[i] << " ";
     }
    infile.close();
    outfile.close();
}
